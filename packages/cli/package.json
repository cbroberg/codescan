{
  "name": "@codescan/cli",
  "version": "0.1.0",
  "description": "CLI interface for CodeScan - semantic code search tool",
  "type": "module",
  "bin": {
    "codescan": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codescan/shared": "workspace:*",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "inquirer": "^10.0.0",
    "ora": "^8.0.0",
    "boxen": "^8.0.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "workspace:*",
    "@types/inquirer": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "workspace:*",
    "vitest": "^2.0.0"
  }
}
