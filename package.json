{
  "name": "codescan",
  "version": "0.1.0",
  "description": "AI-powered semantic code search tool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --no-cache",
    "build": "pnpm --filter @codescan/shared build && pnpm --filter @codescan/api build && pnpm --filter @codescan/cli build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css}\"",
    "server": "cp packages/api/src/services/storage/schema.sql packages/api/dist/services/storage/schema.sql 2>/dev/null; cd packages/api && npm start",
    "api": "pnpm --filter @codescan/api dev",
    "cli": "pnpm --filter @codescan/cli start",
    "web": "pnpm --filter @codescan/web dev",
    "search": "node codefs.js",
    "clean": "turbo run clean && rm -rf node_modules pnpm-lock.yaml"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
