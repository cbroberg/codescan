{
  "tasks": {
    "dev": {
      "cache": false,
      "interactive": true
    },
    "build": {
      "outputs": ["dist/**"],
      "cache": true,
      "dependsOn": ["^build"],
      "concurrency": 1
    },
    "test": {
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "lint": {
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
